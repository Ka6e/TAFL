module Main

func main() {
    let n: int = input();

    if (n <= 1) {
        print(0);
        return;
    }

    let i: int = 2;
    let isPrime: int = 1;

    while (i * i <= n) {
        if (n % i == 0) {
            isPrime = 0;
            break;
        }
        i = i + 1;
    }

    print(isPrime);
}